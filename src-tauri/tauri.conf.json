{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "UFAC",
  "version": "1.1.0",
  "identifier": "com.thgam.ufac",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "UFAC v1.1.0",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Tom Gambro",
    "short description": "USB formatter and audio converter for DJs",
    "long description": "UFAC is an all-in-one tool for formatting USB drives and converting audio files, built for DJs preparing media for CDJs and rekordbox.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/ffmpeg",
      "binaries/ffprobe",
      "binaries/ffplay"
    ]
  }
}
